DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
SQLITE_DB_PATH=data/app.db
VECTOR_STORE_DIR=data/rag
KNOWLEDGE_BASE_DIR=docs/knowledge
EXECUTIONS_DIR=runs
EXECUTION_TIMEOUT_SECONDS=60
MAX_SELF_HEAL_ATTEMPTS=2
MAX_CONCURRENT_EXECUTIONS=1
AGENT_CONTEXT_MAX_TOKENS=4000
# Comma-separated frontend origins for CORS (default localhost:5173)
# FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Per-task model overrides (optional, defaults to MODEL_NAME)
# MODEL_TASK_ANALYSIS=deepseek-chat
# MODEL_PLANNING=deepseek-chat
# MODEL_CODE_GENERATION=deepseek-coder
# MODEL_REPAIR=deepseek-coder
# MODEL_DIAGNOSIS=deepseek-chat
# MODEL_AGENT_REASONING=deepseek-chat